# API is served by Next.js at /api/v1 (same origin). Leave NEXT_PUBLIC_API_URL empty for defaults.
# NEXT_PUBLIC_API_URL=

# Server-only (API routes / Node runtime)
MONGO_URI=mongodb://127.0.0.1:27017/invoicehub
JWT_SECRET=dev-only-change-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional: server-side fetches during SSR (defaults to http://localhost:3000/api/v1)
# INTERNAL_API_URL=http://localhost:3000/api/v1
